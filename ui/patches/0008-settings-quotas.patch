diff -ruN a/packages/app/src/settings/quotas/api.test.ts b/packages/app/src/settings/quotas/api.test.ts
--- a/packages/app/src/settings/quotas/api.test.ts	1970-01-01 02:00:00.000000000 +0200
+++ b/packages/app/src/settings/quotas/api.test.ts	2026-11-14 04:02:26.497968083 +0300
@@ -0,0 +1,215 @@
+import { beforeEach, describe, expect, mock, test } from "bun:test"
+
+type QueryOptions = {
+  enabled?: boolean
+  refetchInterval?: number
+  staleTime?: number
+  retry?: boolean
+  queryKey?: unknown[]
+}
+
+// `api.ts` imports the query layer and the server client at module scope, so the test replaces only
+// those two edges; every formatter, the status vocabulary and the hook wiring stay real.
+let lastOptions: QueryOptions | undefined
+const invalidated: unknown[] = []
+
+mock.module("@tanstack/solid-query", () => ({
+  useQuery: (config: unknown) => {
+    lastOptions = typeof config === "function" ? (config as () => QueryOptions)() : (config as QueryOptions)
+    return { data: undefined, isPending: true, isError: false }
+  },
+  useQueryClient: () => ({
+    invalidateQueries: async (input: unknown) => {
+      invalidated.push(input)
+    },
+    setQueryData: () => undefined,
+  }),
+}))
+
+mock.module("@/runtime/server/client", () => ({
+  useServerSDK: () => ({ scope: "test", http: { url: "http://server.test" } }),
+}))
+
+const {
+  QUOTA_STATUSES,
+  QuotaRequestError,
+  antigravityPoolRemaining,
+  formatCompactNumber,
+  formatCountdownDuration,
+  formatCurrencyValue,
+  formatQuotaWindowValue,
+  quotasData,
+  quotasUnavailable,
+  statusLabelKey,
+  useQuotasData,
+} = await import("./api")
+
+const { dict: english } = await import("@/runtime/i18n/en")
+const { dict: turkish } = await import("@/runtime/i18n/tr")
+
+beforeEach(() => {
+  lastOptions = undefined
+  invalidated.length = 0
+})
+
+describe("formatCurrencyValue", () => {
+  test("formats two decimals for ordinary amounts", () => {
+    expect(formatCurrencyValue(12.5, "USD", "en-US")).toBe("$12.50")
+    expect(formatCurrencyValue(0, "USD", "en-US")).toBe("$0.00")
+  })
+
+  test("keeps four decimals for sub-cent amounts so a tiny spend is not shown as zero", () => {
+    expect(formatCurrencyValue(0.0042, "USD", "en-US")).toBe("$0.0042")
+    expect(formatCurrencyValue(-0.0042, "USD", "en-US")).toBe("-$0.0042")
+  })
+
+  test("accepts a lowercase ISO code and falls back to USD for an unknown one", () => {
+    expect(formatCurrencyValue(3, "eur", "en-US")).toBe("€3.00")
+    expect(formatCurrencyValue(3, "euros", "en-US")).toBe("$3.00")
+    expect(formatCurrencyValue(3, "", "en-US")).toBe("$3.00")
+  })
+})
+
+describe("formatCompactNumber", () => {
+  test("leaves numbers below a thousand alone", () => {
+    expect(formatCompactNumber(0, "en-US")).toBe("0")
+    expect(formatCompactNumber(999, "en-US")).toBe("999")
+    expect(formatCompactNumber(-42, "en-US")).toBe("-42")
+  })
+
+  test("uses one decimal for thousands and two for millions", () => {
+    expect(formatCompactNumber(1_000, "en-US")).toBe("1.0K")
+    expect(formatCompactNumber(1_540, "en-US")).toBe("1.5K")
+    expect(formatCompactNumber(1_500_000, "en-US")).toBe("1.50M")
+    expect(formatCompactNumber(-2_500, "en-US")).toBe("-2.5K")
+  })
+})
+
+describe("formatCountdownDuration", () => {
+  const now = 1_700_000_000_000
+
+  test("returns nothing for a window that already reset or has no time", () => {
+    expect(formatCountdownDuration(now, now)).toBeUndefined()
+    expect(formatCountdownDuration(now - 1, now)).toBeUndefined()
+    expect(formatCountdownDuration(Number.NaN, now)).toBeUndefined()
+    expect(formatCountdownDuration(Number.POSITIVE_INFINITY, now)).toBeUndefined()
+  })
+
+  test("rounds up to whole minutes, then hours, then days", () => {
+    expect(formatCountdownDuration(now + 30_000, now)).toBe("1m")
+    expect(formatCountdownDuration(now + 59 * 60_000, now)).toBe("59m")
+    expect(formatCountdownDuration(now + 60 * 60_000, now)).toBe("1h 0m")
+    expect(formatCountdownDuration(now + (2 * 24 * 60 + 3 * 60) * 60_000, now)).toBe("2d 3h")
+  })
+})
+
+describe("formatQuotaWindowValue", () => {
+  test("prints a percent window without a unit suffix", () => {
+    expect(formatQuotaWindowValue({ id: "w", label: "Context", unit: "percent" }, 42.4, "en-US")).toBe("42%")
+  })
+
+  test("treats a currency unit as money and anything else as a compact count", () => {
+    expect(formatQuotaWindowValue({ id: "w", label: "Spend", unit: "usd" }, 12.5, "en-US")).toBe("$12.50")
+    expect(formatQuotaWindowValue({ id: "w", label: "Tokens", unit: "tokens" }, 1_540, "en-US")).toBe("1.5K tokens")
+  })
+})
+
+describe("antigravityPoolRemaining", () => {
+  test("reads a fraction as a percentage and a whole number as one", () => {
+    expect(antigravityPoolRemaining({ remainingFraction: 0.42 })).toBeCloseTo(42)
+    expect(antigravityPoolRemaining({ remainingFraction: 42 })).toBe(42)
+  })
+
+  test("derives the remainder from usedPercent and clamps to 0..100", () => {
+    expect(antigravityPoolRemaining({ usedPercent: 30 })).toBe(70)
+    // A value above 1 is already a percentage, not a fraction: 1.4 stays 1.4%.
+    expect(antigravityPoolRemaining({ remainingFraction: 1.4 })).toBe(1.4)
+    expect(antigravityPoolRemaining({ remainingFraction: -0.5 })).toBe(0)
+    expect(antigravityPoolRemaining({ usedPercent: 130 })).toBe(0)
+    expect(antigravityPoolRemaining({ usedPercent: -20 })).toBe(100)
+  })
+
+  test("reports nothing when the snapshot carries no number", () => {
+    expect(antigravityPoolRemaining({})).toBeUndefined()
+  })
+})
+
+describe("statusLabelKey", () => {
+  test("every server status maps to a localized, non-empty label in both shipped locales", () => {
+    for (const status of QUOTA_STATUSES) {
+      const key = statusLabelKey(status)
+      expect(key.startsWith("settings.quotas.status.")).toBe(true)
+      expect((english[key] ?? "").trim().length).toBeGreaterThan(0)
+      expect((turkish[key] ?? "").trim().length).toBeGreaterThan(0)
+    }
+  })
+
+  test("an unknown token never reaches the UI as raw server text", () => {
+    expect(statusLabelKey("vendor_specific_thing" as never)).toBe("settings.quotas.status.unavailable")
+    expect(english[statusLabelKey("something_new")]).toBe("Unavailable")
+  })
+})
+
+describe("quotasData / quotasUnavailable", () => {
+  test("splits the detached snapshot from a real payload", () => {
+    const payload = {
+      fetchedAtMs: 1,
+      summary: {
+        providerCount: 1,
+        liveQuotaCount: 1,
+        spend5hUsd: 0,
+        spend24hUsd: 0,
+        spend7dUsd: 0,
+        spend30dUsd: 0,
+      },
+      providers: [],
+    }
+
+    expect(quotasData(payload)).toBe(payload)
+    expect(quotasUnavailable(payload)).toBeUndefined()
+    expect(quotasData({ unavailable: true, message: "detached" })).toBeUndefined()
+    expect(quotasUnavailable({ unavailable: true, message: "detached" })).toEqual({
+      unavailable: true,
+      message: "detached",
+    })
+    expect(quotasData(undefined)).toBeUndefined()
+  })
+})
+
+describe("QuotaRequestError", () => {
+  test("keeps the status and the server's kind for in-place error states", () => {
+    const error = new QuotaRequestError(409, "env owns the key", "env_managed")
+
+    expect(error).toBeInstanceOf(Error)
+    expect(error.name).toBe("QuotaRequestError")
+    expect(error.status).toBe(409)
+    expect(error.kind).toBe("env_managed")
+    expect(new QuotaRequestError(500, "boom").kind).toBeUndefined()
+  })
+})
+
+describe("useQuotasData", () => {
+  test("polls only when asked: a disabled reader passes enabled=false and no interval", () => {
+    useQuotasData({ enabled: () => false })
+
+    expect(lastOptions?.enabled).toBe(false)
+    expect(lastOptions?.refetchInterval).toBeUndefined()
+    expect(lastOptions?.staleTime).toBe(30_000)
+    // A detached 503 is a state, not a failure: retrying would only repeat it.
+    expect(lastOptions?.retry).toBe(false)
+  })
+
+  test("defaults to an enabled, non-polling query", () => {
+    useQuotasData()
+
+    expect(lastOptions?.enabled).toBe(true)
+    expect(lastOptions?.refetchInterval).toBeUndefined()
+  })
+
+  test("the settings tab is the only caller that sets an interval", () => {
+    useQuotasData({ refetchInterval: 60_000 })
+
+    expect(lastOptions?.enabled).toBe(true)
+    expect(lastOptions?.refetchInterval).toBe(60_000)
+  })
+})
diff -ruN a/packages/app/src/settings/quotas/api.ts b/packages/app/src/settings/quotas/api.ts
--- a/packages/app/src/settings/quotas/api.ts	1970-01-01 02:00:00.000000000 +0200
+++ b/packages/app/src/settings/quotas/api.ts	2026-11-14 04:02:26.497815451 +0300
@@ -0,0 +1,388 @@
+import { useQuery, useQueryClient } from "@tanstack/solid-query"
+import { useServerSDK } from "@/runtime/server/client"
+import { isConfigObject, serverMessage, useAgenticRequest } from "@/settings/agentic/config"
+
+export type QuotaCapability = "live_api" | "rate_limit_headers_only"
+
+/** Where the OpenRouter management key the server uses comes from. */
+export type ManagementKeySource = "env" | "credential" | "config"
+
+export interface UnifiedQuotaSummary {
+  providerCount: number
+  liveQuotaCount: number
+  spend5hUsd: number
+  spend24hUsd: number
+  spend7dUsd: number
+  spend30dUsd: number
+}
+
+export interface QuotaWindow {
+  id: string
+  label: string
+  unit: string
+  groupKey?: string
+  limit?: number
+  used?: number
+  remaining?: number
+  usedPercent?: number
+  remainingPercent?: number
+  limited?: boolean
+  resetAtMs?: number
+  resetLabel?: string
+}
+
+export interface ProviderBalanceSummary {
+  currency: string
+  total?: number
+  remaining?: number
+  used?: number
+  toppedUp?: number
+  granted?: number
+  isAvailable?: boolean
+  isFreeTier?: boolean
+}
+
+export interface ProviderApiSpend {
+  currency: string
+  total?: number
+  daily?: number
+  weekly?: number
+  monthly?: number
+}
+
+export interface ProviderRateLimit {
+  providerId: string
+  modelId: string
+  observedAtMs: number
+  status: number
+  requestsLimit?: number
+  requestsRemaining?: number
+  requestsResetAtMs?: number
+  requestsResetRaw?: string
+  tokensLimit?: number
+  tokensRemaining?: number
+  tokensResetAtMs?: number
+  tokensResetRaw?: string
+  retryAfterMs?: number
+}
+
+export interface AntigravityQuotaGroupSnapshot {
+  remainingFraction?: number
+  usedPercent?: number
+  resetTimeMs?: number
+}
+
+export interface AntigravityCachedQuota {
+  updatedAt: number
+  groups: Record<string, AntigravityQuotaGroupSnapshot>
+}
+
+export interface AntigravityAccountStatus {
+  index: number
+  id: string
+  email?: string
+  label?: string
+  activeClaude: boolean
+  activeGemini: boolean
+  enabled: boolean
+  verificationRequired: boolean
+  revoked: boolean
+  projectId?: string
+  tier?: string
+  quota?: AntigravityCachedQuota
+  addedAt: number
+  lastUsed: number
+}
+
+export interface UsageWindowTotals {
+  steps: number
+  inputTokens: number
+  outputTokens: number
+  reasoningTokens: number
+  cacheReadTokens: number
+  cacheWriteTokens: number
+  totalTokens: number
+  costUsd: number
+}
+
+export interface ModelUsageRow {
+  modelID: string
+  steps: number
+  totalTokens: number
+  costUsd: number
+}
+
+export interface ProviderLocalUsage {
+  fiveHours: UsageWindowTotals
+  day: UsageWindowTotals
+  week: UsageWindowTotals
+  month: UsageWindowTotals
+  allTime: UsageWindowTotals
+  topModels?: ModelUsageRow[]
+}
+
+export interface ProviderQuotaEntry {
+  providerID: string
+  name: string
+  connected: boolean
+  connectionSource: string
+  capability: QuotaCapability
+  capabilityNote?: string
+  status: string
+  fetchedAtMs?: number
+  cached?: boolean
+  hasManagementKey?: boolean
+  managementKeySource?: ManagementKeySource
+  keyLabel?: string
+  rateLimitRule?: string
+  windows?: QuotaWindow[]
+  balances?: ProviderBalanceSummary[]
+  spendSummary?: ProviderApiSpend
+  rateLimit?: ProviderRateLimit
+  accounts?: AntigravityAccountStatus[]
+  localUsage?: ProviderLocalUsage
+  warnings?: string[]
+  error?: string
+}
+
+export interface UnifiedQuotasResponse {
+  fetchedAtMs: number
+  summary: UnifiedQuotaSummary
+  providers: ProviderQuotaEntry[]
+}
+
+/** The server answers `503` when it runs without the quota service. */
+export interface QuotasUnavailable {
+  unavailable: true
+  message?: string
+}
+
+export type QuotasSnapshot = UnifiedQuotasResponse | QuotasUnavailable
+
+/** The unified payload, or `undefined` while pending or when the service is detached. */
+export function quotasData(value: QuotasSnapshot | undefined): UnifiedQuotasResponse | undefined {
+  return value && !("unavailable" in value) ? value : undefined
+}
+
+export function quotasUnavailable(value: QuotasSnapshot | undefined): QuotasUnavailable | undefined {
+  return value && "unavailable" in value ? value : undefined
+}
+
+/** A failed quota request, with the server's error kind when it names one. */
+export class QuotaRequestError extends Error {
+  readonly status: number
+  readonly kind: string | undefined
+
+  constructor(status: number, message: string, kind?: string) {
+    super(message)
+    this.name = "QuotaRequestError"
+    this.status = status
+    this.kind = kind
+  }
+}
+
+/** The server's status vocabulary for a provider entry. */
+export const QUOTA_STATUSES = [
+  "ok",
+  "partial",
+  "error",
+  "unsupported",
+  "headers_only",
+  "local_only",
+  "no_api_key",
+  "not_connected",
+  "disconnected",
+  "unavailable",
+] as const
+
+export type QuotaStatusLabelKey =
+  | "settings.quotas.status.ok"
+  | "settings.quotas.status.partial"
+  | "settings.quotas.status.error"
+  | "settings.quotas.status.unsupported"
+  | "settings.quotas.status.headersOnly"
+  | "settings.quotas.status.localOnly"
+  | "settings.quotas.status.noApiKey"
+  | "settings.quotas.status.notConnected"
+  | "settings.quotas.status.disconnected"
+  | "settings.quotas.status.unavailable"
+
+/** Every server status maps to a localized label; unknown tokens never reach the UI. */
+export function statusLabelKey(status: string): QuotaStatusLabelKey {
+  switch (status) {
+    case "ok":
+      return "settings.quotas.status.ok"
+    case "partial":
+      return "settings.quotas.status.partial"
+    case "error":
+      return "settings.quotas.status.error"
+    case "unsupported":
+      return "settings.quotas.status.unsupported"
+    case "headers_only":
+      return "settings.quotas.status.headersOnly"
+    case "local_only":
+      return "settings.quotas.status.localOnly"
+    case "no_api_key":
+      return "settings.quotas.status.noApiKey"
+    case "not_connected":
+      return "settings.quotas.status.notConnected"
+    case "disconnected":
+      return "settings.quotas.status.disconnected"
+    default:
+      return "settings.quotas.status.unavailable"
+  }
+}
+
+const QUOTAS_QUERY_KEY = ["quotas", "unified"] as const
+
+export interface UseQuotasDataOptions {
+  /** Reads reactively; a detached dialog passes `() => false` until it needs the data. */
+  enabled?: () => boolean
+  /** Poll interval in ms. Only the settings panel polls; the dialog reads the cached snapshot. */
+  refetchInterval?: number
+}
+
+/** Reads the error kind out of a failed response without consuming the body twice. */
+async function requestError(response: Response): Promise<QuotaRequestError> {
+  const copy = response.clone()
+  const message = await serverMessage(response)
+  let kind: string | undefined
+
+  try {
+    const body: unknown = await copy.json()
+    if (isConfigObject(body)) {
+      const data = body.data
+      if (isConfigObject(data) && typeof data.kind === "string") kind = data.kind
+      else if (typeof body.kind === "string") kind = body.kind
+    }
+  } catch {
+    // Not JSON.
+  }
+
+  return new QuotaRequestError(response.status, message, kind)
+}
+
+export function useQuotasData(options: UseQuotasDataOptions = {}) {
+  const client = useQueryClient()
+  const sdk = useServerSDK()
+  const request = useAgenticRequest()
+
+  const query = useQuery<QuotasSnapshot>(() => ({
+    queryKey: [sdk.scope, ...QUOTAS_QUERY_KEY],
+    queryFn: async (): Promise<QuotasSnapshot> => {
+      const response = await request("/api/quotas")
+      // A server without the quota service is a soft state, not an error.
+      if (response.status === 503) {
+        return { unavailable: true, message: await serverMessage(response) }
+      }
+      if (!response.ok) throw await requestError(response)
+      const payload = (await response.json()) as { data?: UnifiedQuotasResponse }
+      if (!payload.data) throw new Error("Missing quotas response data")
+      return payload.data
+    },
+    staleTime: 30_000,
+    enabled: options.enabled?.() ?? true,
+    retry: false,
+    refetchInterval: options.refetchInterval,
+  }))
+
+  const refreshLive = async () => {
+    const response = await request("/api/quotas/refresh", { method: "POST" })
+    if (!response.ok) throw await requestError(response)
+    const payload = (await response.json()) as { data?: UnifiedQuotasResponse }
+    if (payload.data) {
+      client.setQueryData([sdk.scope, ...QUOTAS_QUERY_KEY], payload.data)
+    } else {
+      await client.invalidateQueries({ queryKey: [sdk.scope, ...QUOTAS_QUERY_KEY] })
+    }
+    return payload.data
+  }
+
+  const invalidate = () => client.invalidateQueries({ queryKey: [sdk.scope, ...QUOTAS_QUERY_KEY] })
+
+  const saveOpenRouterManagementKey = async (key: string) => {
+    const response = await request("/api/quotas/openrouter/management-key", {
+      method: "PUT",
+      body: JSON.stringify({ key }),
+    })
+    if (!response.ok) throw await requestError(response)
+    // One invalidation re-reads the cache; a live probe of every provider is reserved for Refresh.
+    await invalidate()
+  }
+
+  const clearOpenRouterManagementKey = async () => {
+    const response = await request("/api/quotas/openrouter/management-key", {
+      method: "DELETE",
+    })
+    if (!response.ok) throw await requestError(response)
+    await invalidate()
+  }
+
+  const mutateAntigravityAccount = async (id: string, action: "select" | "enable" | "disable") => {
+    const response = await request(`/api/antigravity/accounts/${encodeURIComponent(id)}/${action}`, {
+      method: "POST",
+    })
+    if (!response.ok) throw await requestError(response)
+    await invalidate()
+  }
+
+  return {
+    query,
+    refreshLive,
+    invalidate,
+    saveOpenRouterManagementKey,
+    clearOpenRouterManagementKey,
+    mutateAntigravityAccount,
+  }
+}
+
+export function formatCurrencyValue(value: number, currency = "USD", locale?: string): string {
+  const code = /^[A-Z]{3}$/.test(currency.toUpperCase()) ? currency.toUpperCase() : "USD"
+  return new Intl.NumberFormat(locale, {
+    style: "currency",
+    currency: code,
+    minimumFractionDigits: Math.abs(value) > 0 && Math.abs(value) < 0.01 ? 4 : 2,
+    maximumFractionDigits: Math.abs(value) > 0 && Math.abs(value) < 0.01 ? 4 : 2,
+  }).format(value)
+}
+
+export function formatCompactNumber(value: number, locale?: string): string {
+  if (Math.abs(value) >= 1_000_000) {
+    return `${(value / 1_000_000).toFixed(2)}M`
+  }
+  if (Math.abs(value) >= 1_000) {
+    return `${(value / 1_000).toFixed(1)}K`
+  }
+  return new Intl.NumberFormat(locale).format(value)
+}
+
+export function formatCountdownDuration(targetMs: number, nowMs = Date.now()): string | undefined {
+  const diff = targetMs - nowMs
+  if (!Number.isFinite(diff) || diff <= 0) return undefined
+  const totalMinutes = Math.ceil(diff / 60_000)
+  const days = Math.floor(totalMinutes / (60 * 24))
+  const hours = Math.floor((totalMinutes % (60 * 24)) / 60)
+  const mins = totalMinutes % 60
+  if (days > 0) return `${days}d ${hours}h`
+  if (hours > 0) return `${hours}h ${mins}m`
+  return `${mins}m`
+}
+
+export function formatQuotaWindowValue(window: QuotaWindow, value: number, locale?: string): string {
+  if (window.unit === "percent") return `${Math.round(value)}%`
+  if (/^[A-Z]{3}$/.test(window.unit.toUpperCase())) {
+    return formatCurrencyValue(value, window.unit, locale)
+  }
+  return `${formatCompactNumber(value, locale)} ${window.unit}`
+}
+
+export function antigravityPoolRemaining(group: AntigravityQuotaGroupSnapshot): number | undefined {
+  if (typeof group.remainingFraction === "number") {
+    const pct = group.remainingFraction <= 1 ? group.remainingFraction * 100 : group.remainingFraction
+    return Math.max(0, Math.min(100, pct))
+  }
+  if (typeof group.usedPercent === "number") {
+    return Math.max(0, Math.min(100, 100 - group.usedPercent))
+  }
+  return undefined
+}
